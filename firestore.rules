rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identité protégée (super admin) ----------
    // Doit rester EXACTEMENT synchronisé avec SUPER_ADMIN_EMAILS dans
    // src/config.local.js. Ce compte ne peut jamais être modifié/désactivé
    // par personne d'autre que lui-même (voir isProtectedTarget()).
    function superAdminEmails() {
      return ['esmelyann@gmail.com'];
    }

    function isSuperAdminIdentity() {
      return isSignedIn() && request.auth.token.email != null &&
        request.auth.token.email.lower() in superAdminEmails();
    }

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function employeExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/employes/$(request.auth.uid));
    }

    function myData() {
      return get(/databases/$(database)/documents/employes/$(request.auth.uid)).data;
    }

    function myRole() {
      return myData().role;
    }

    // Un compte désactivé (disabled: true) perd tous ses droits, même s'il
    // garde un rôle enregistré.
    function isActive() {
      return employeExists() && myData().disabled != true;
    }

    function isSuperAdmin() {
      return isActive() && myRole() == 'super_admin';
    }

    function isDrPrincipal() {
      return isActive() && myRole() == 'dr_principal';
    }

    function isAdmin() {
      // Peut gérer les rôles / désactiver des comptes
      return isDrPrincipal() || isSuperAdmin();
    }

    function isReviewer() {
      // Docteur Principal + Docteur Délégué (REVIEWER_ROLES côté client)
      return isActive() && myRole() in ['dr_principal', 'dr_delegue'];
    }

    function isClinical() {
      // CLINICAL_ROLES côté client : accès dashboard / patients
      return isActive() && myRole() in ['dr_principal', 'dr_delegue', 'pharmacien'];
    }

    function isComptable() {
      return isActive() && myRole() == 'comptable';
    }

    function isEmploye() {
      // N'importe quel membre du personnel actif
      return isActive();
    }

    // Conversations privées : l'id est « dm_<uidA>_<uidB> » (UID triés). Les UID
    // Firebase ne contiennent jamais de « _ », donc le split est fiable.
    function isDmMember(convId) {
      let p = convId.split('_');
      return p.size() == 3 && p[0] == 'dm' &&
        (p[1] == request.auth.uid || p[2] == request.auth.uid);
    }

    function canAccessConv(convId) {
      return convId == 'general' || isDmMember(convId);
    }

    // Le document employes CIBLE (resource) appartient-il au compte protégé ?
    function isProtectedTarget() {
      return resource.data.email != null && resource.data.email.lower() in superAdminEmails();
    }

    // ---------- employes ----------
    match /employes/{uid} {
      // Chacun peut lire son propre document (nécessaire dès le premier login,
      // avant même que le doc existe côté migration). Tout employé actif peut
      // aussi lire l'annuaire (nom, rôle, email) : indispensable à la messagerie
      // interne et à l'administration (AdminPage).
      allow read: if isSignedIn() && (request.auth.uid == uid || isEmploye());
      allow create: if isSignedIn() && request.auth.uid == uid;

      // Mise à jour :
      // - soi-même : jamais le champ "role" (sauf le vrai super admin qui se
      //   force lui-même en 'super_admin' via le garde-fou du code) ni "disabled".
      // - Dr Principal / Super Admin : peuvent changer role/disabled de
      //   n'importe qui SAUF le compte protégé (super admin).
      allow update: if isSignedIn() && (
        (
          request.auth.uid == uid &&
          request.resource.data.disabled == resource.data.disabled &&
          (request.resource.data.role == resource.data.role || isSuperAdminIdentity())
        )
        ||
        (isAdmin() && !isProtectedTarget())
      );

      // On ne supprime jamais un profil : on le désactive (disabled: true).
      allow delete: if false;
    }

    // ---------- pharmaciens (collection legacy, migration uniquement) ----------
    match /pharmaciens/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- patients (dossiers cliniques) ----------
    match /patients/{patientId} {
      allow create: if isClinical() &&
        request.resource.data.pharmacienId == request.auth.uid;
      allow read, update, delete: if isClinical() &&
        resource.data.pharmacienId == request.auth.uid;
    }

    // ---------- reclamations (visibles par tous les employés actifs) ----------
    match /reclamations/{id} {
      allow read: if isEmploye();
      allow create: if isEmploye() &&
        request.resource.data.auteurId == request.auth.uid;
      allow update: if isReviewer();
      allow delete: if false;
    }

    // ---------- demandes_permission (formulaire « Demande de permission ») ----------
    // Le demandeur crée la demande (avec sa signature) ; le Docteur Principal /
    // Super Admin ne peut ensuite que renseigner la décision, une seule fois.
    match /demandes_permission/{id} {
      allow create: if isEmploye() &&
        request.resource.data.employeId == request.auth.uid &&
        request.resource.data.statut == 'en_attente';
      allow read: if isEmploye() &&
        (resource.data.employeId == request.auth.uid || isDrPrincipal() || isSuperAdmin());
      allow update: if (isDrPrincipal() || isSuperAdmin()) &&
        resource.data.statut == 'en_attente' &&
        request.resource.data.statut in ['approuvee', 'refusee'] &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['statut', 'decision', 'traiteAt', 'traiteParId']);
      allow delete: if false;
    }

    // ---------- remarques_anonymes ----------
    match /remarques_anonymes/{id} {
      allow create: if isEmploye();
      allow read: if isReviewer();
      allow update, delete: if false;
    }

    // ---------- rapports_comptables ----------
    match /rapports_comptables/{id} {
      allow create: if isComptable() &&
        request.resource.data.auteurId == request.auth.uid;
      allow read: if isReviewer() ||
        (isComptable() && resource.data.auteurId == request.auth.uid);
      allow update, delete: if false;
    }

    // ---------- Messagerie interne ----------
    // conversations/general            : discussion générale (tous les employés actifs)
    // conversations/dm_<uidA>_<uidB>   : conversation privée entre deux employés
    match /conversations/{convId} {
      // Les requêtes de liste passent par « participants array-contains uid ».
      allow read: if isEmploye() &&
        (convId == 'general' ||
          (resource != null && request.auth.uid in resource.data.participants));

      allow create: if isEmploye() && (
        (convId == 'general' && request.resource.data.type == 'general') ||
        (isDmMember(convId) &&
          request.resource.data.type == 'direct' &&
          request.resource.data.participants.size() == 2 &&
          request.resource.data.participants.hasAll(convId.split('_')[1:3]))
      );

      // Le document résumé (dernier message) est mis à jour à chaque envoi.
      allow update: if isEmploye() && (
        (convId == 'general' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'updatedAt'])) ||
        (isDmMember(convId) &&
          request.resource.data.participants == resource.data.participants)
      );
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isEmploye() && canAccessConv(convId);
        allow create: if isEmploye() && canAccessConv(convId) &&
          request.resource.data.keys().hasOnly(['senderId', 'senderName', 'senderRole', 'text', 'createdAt']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.createdAt == request.time;
        // Messages non modifiables et non supprimables.
        allow update, delete: if false;
      }
    }

    // Date de dernière lecture de chaque conversation, propre à chaque employé.
    match /chat_reads/{uid} {
      allow read, write: if isEmploye() && request.auth.uid == uid;
    }

    // Tout le reste : refusé par défaut (comportement implicite de Firestore).
  }
}
